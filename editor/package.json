{
  "name": "rotulos-web",
  "version": "3.3.0",
  "description": "Rótulos Web – Editor Visual Universal Soberano",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:css && npm run build:js",
    "build:css": "cleancss -o public/style.min.css public/style.css",
    "build:js": "terser public/app.js -c -m -o public/app.min.js",
    "pkg": "pkg . --targets node18-linux-x64 --output dist/rotulos-web-linux",
    "pkg:all": "pkg . --targets node18-linux-x64,node18-win-x64,node18-macos-x64 --output dist/rotulos-web",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "axe-core": "^4.13.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "grapesjs": "^0.23.6",
    "grapesjs-blocks-basic": "^1.0.2",
    "open": "^11.0.2",
    "puppeteer-core": "^25.10.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@yao-pkg/pkg": "^6.22.0",
    "babel-jest": "^29.7.0",
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "terser": "^5.39.0"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "locales/**/*"
    ]
  }
}
