{
  "name": "rotulos-web",
  "version": "5.0.0",
  "description": "Rótulos Web – Editor Visual Universal Soberano",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:css && npm run build:js",
    "build:css": "cleancss -o public/style.min.css public/style.css",
    "build:js": "terser public/app.js -c -m -o public/app.min.js",
    "pkg": "pkg . --targets node18-linux-x64 --output dist/rotulos-web-linux",
    "pkg:all": "pkg . --targets node18-linux-x64,node18-win-x64,node18-macos-x64 --output dist/rotulos-web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint server.js server/ public/modules/ tests/",
    "lint:fix": "eslint --fix server.js server/ public/modules/ tests/"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "axe-core": "^4.13.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "grapesjs": "^0.23.6",
    "grapesjs-blocks-basic": "^1.0.2",
    "open": "^11.0.2",
    "puppeteer-core": "^25.10.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.7",
    "@yao-pkg/pkg": "^6.22.0",
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "supertest": "^7.2.2",
    "terser": "^5.39.0",
    "vitest": "^3.2.7"
  },
  "vitest": {
    "environment": "jsdom",
    "globals": true,
    "include": [
      "tests/**/*.test.js"
    ]
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "locales/**/*"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
